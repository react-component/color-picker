{
  "name": "@rc-component/color-picker",
  "version": "3.1.1",
  "description": "React Color Picker",
  "keywords": [
    "react",
    "react-component",
    "react-mentions",
    "color-picker"
  ],
  "homepage": "https://react-component.github.io/color-picker",
  "bugs": {
    "url": "https://github.com/react-component/color-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-component/color-picker.git"
  },
  "license": "MIT",
  "main": "./lib/index",
  "module": "./es/index",
  "files": [
    "assets",
    "es",
    "lib"
  ],
  "scripts": {
    "build": "npm run docs:build",
    "compile": "father build && lessc assets/index.less assets/index.css",
    "coverage": "vitest run --coverage",
    "docs:build": "dumi build",
    "docs:deploy": "gh-pages -d docs-dist",
    "docs:preview": "PREVIEW=true dumi build",
    "gh-pages": "npm run docs:build:gh-pages && npm run docs:deploy",
    "lint": "eslint src/ --ext .tsx,.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run compile && rc-np",
    "prettier": "prettier --write --ignore-unknown .",
    "postpublish": "npm run gh-pages",
    "start": "dumi dev",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "docs:build:gh-pages": "GH_PAGES=1 npm run docs:build"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@ant-design/fast-color": "^3.0.1",
    "@rc-component/util": "^1.11.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/eslint-plugin": "^7.29.7",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@rc-component/father-plugin": "^2.2.0",
    "@rc-component/np": "^1.0.4",
    "@rc-component/trigger": "^1.13.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/warning": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@umijs/fabric": "^4.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "dumi": "^2.4.38",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "father": "^4.6.24",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "less": "^4.6.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./es/index.d.ts"
}
